# Frankman Furniture & Electronics - Environment Variables Example
# Copy this file to .env and configure for local development and Neon/Vercel deployment.

# Neon PostgreSQL Database Connection (Pooled connection for high-concurrency app traffic)
DATABASE_URL="postgresql://frankman_user:your_password@ep-cool-sample.eu-central-1.aws.neon.tech/frankman_db?sslmode=require&pgbouncer=true"

# Direct Database URL (Used by Prisma for migrations and schema pushing)
DIRECT_URL="postgresql://frankman_user:your_password@ep-cool-sample.eu-central-1.aws.neon.tech/frankman_db?sslmode=require"

# Application Server Port (Defaults to 3000)
PORT=3000

# Administrative & Session Authentication Secret
AUTH_SECRET="frankman_super_secret_session_key_2026_umuahia"

# Public Brand Information
VITE_SITE_URL="https://frankman.ng"
VITE_WHATSAPP_NUMBER="+2348031234567"
VITE_FACEBOOK_URL="https://www.facebook.com/profile.php?id=61569349703465"

# Paystack Gateway Architecture (Readiness Mode)
# PAYSTACK_SECRET_KEY="sk_test_..."
# PAYSTACK_PUBLIC_KEY="pk_test_..."
